		"svelte-check": "4.7.7",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"vite": "8.3.5",
		"vitest": "4.1.12"
	},
	"description": "Landing page for webmcpx and its benchmark.",
	"license": "MIT OR Apache-2.0",
	"dependencies": {
