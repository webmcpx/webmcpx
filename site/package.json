{
	"name": "webmcpx-site",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest --run",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@eslint/js": "10.0.1",
		"@fontsource-variable/bricolage-grotesque": "5.3.0",
		"@fontsource-variable/geist": "5.3.0",
		"@fontsource-variable/geist-mono": "5.3.0",
		"@lucide/svelte": "1.70.0",
		"@playwright/test": "1.65.0",
		"@sveltejs/adapter-static": "4.0.1",
		"@sveltejs/kit": "3.1.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.5",
		"@types/node": "24.19.2",
		"eslint": "10.14.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.24.0",
		"globals": "17.14.0",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"shiki": "4.6.0",
		"simple-icons": "16.36.0",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"tailwind-variants": "4.0.1",
		"tailwindcss": "4.3.5",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.1",
		"vite": "8.3.6",
		"vitest": "5.1.0"
	},
	"description": "Landing page for webmcpx and its benchmark.",
	"license": "MIT OR Apache-2.0",
	"dependencies": {
		"webmcpx": "file:../packages/webmcpx"
	}
}
