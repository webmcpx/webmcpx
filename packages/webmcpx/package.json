{
  "name": "webmcpx",
  "version": "0.2.3",
  "description": "Standard WebMCP tools for any website, and an MCP server that gives any agent the WebMCP tools of the pages it opens.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://webmcpx.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webmcpx/webmcpx.git",
    "directory": "packages/webmcpx"
  },
  "keywords": [
    "agent",
    "ai-agents",
    "mcp",
    "mcp-server",
    "model-context",
    "polyfill",
    "react",
    "svelte",
    "vue",
    "wasm",
    "webmcp"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./auto": "./src/auto.js",
    "./react": {
      "types": "./src/react.d.ts",
      "default": "./src/react.js"
    },
    "./vue": {
      "types": "./src/vue.d.ts",
      "default": "./src/vue.js"
    },
    "./svelte": {
      "types": "./src/svelte.d.ts",
      "default": "./src/svelte.js"
    }
  },
  "types": "./src/index.d.ts",
  "bin": {
    "webmcpx": "bin/webmcpx.js"
  },
  "files": [
    "dist",
    "src",
    "agent",
    "bin",
    "wasm/webmcpx_wasm.js",
    "wasm/webmcpx_wasm_bg.wasm",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/auto.js",
    "./src/auto.js"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "pretest": "node scripts/build.mjs",
    "test": "node --test --experimental-test-module-mocks"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@w3c/webmcp-polyfill": "0.1.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "linkedom": "0.18.15",
    "react": "19.3.1",
    "svelte": "5.57.3",
    "vue": "3.5.45"
  },
  "bugs": {
    "url": "https://github.com/webmcpx/webmcpx/issues"
  },
  "peerDependencies": {
    "react": ">=16.8",
    "svelte": ">=3",
    "vue": ">=2.7"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  }
}
